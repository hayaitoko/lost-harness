# Rust / Cargo
src-tauri/target/
# Cargo.lock IS committed — this is a shipped application, not a library, so the
# exact dependency graph must be reproducible across the dev box and CI.
src-tauri/.tauri/
**/*.rs.bk
*.pdb
*.dSYM/

# Node / Vite
node_modules/
dist/
.svelte-kit/
.vite/
*.local
.npm/
.eslintcache
coverage/
test-results/
playwright-report/

# Tauri
src-tauri/gen/

# IDEs
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.*
!.env.example
!.env.*.example
.envrc.local

# Credentials and signing material — credentials belong in the OS keychain or
# the CI secret store, never in the repository.
*.pem
*.key
*.p12
*.pfx
*.mobileprovision
credentials*.json
oauth-client*.json

# Local model/runtime artifacts
models/
*.gguf
